# Control Tower API - Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
# For production: DATABASE_URL=postgresql://user:pass@host:5432/dbname
# For development (SQLite):
DATABASE_URL=file:./dev.db

# JWT
# IMPORTANT: In production, JWT_SECRET must be set and NOT be the placeholder
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://trafic.generarise.space
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=Control-Tower

# AI Providers
GROQ_API_KEY=your-groq-api-key
GROQ_TEXT_MODEL=groq/compound
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=your-openai-api-key

AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini

# WhatsApp Webhook
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret

# Map tiles
VITE_CARTO_API_KEY=your-carto-api-key

# Seed demo data (set to true only for first run in development)
SEED_DEMO_DATA=false