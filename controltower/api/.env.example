# =============================================================================
# Control Tower 360 — Plantilla de variables de entorno
# =============================================================================
# Copiar este archivo como ".env" y completar con valores reales.
# NUNCA commitear el archivo .env con valores reales al repositorio.
# =============================================================================

# ----- Entorno -----
NODE_ENV=development
PORT=3000

# ----- Seguridad JWT -----
# REQUERIDO en producción. Si NODE_ENV=production y esta variable está vacía,
# la aplicación NO inicia. En desarrollo se permite un valor por defecto.
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h

# ----- Base de datos SQLite -----
# Ruta absoluta al archivo SQLite. Por defecto ./dev.db
DB_PATH=

# ----- CORS -----
# Lista separada por comas con los orígenes permitidos para el frontend.
# Ejemplo producción:
#   CORS_ORIGINS=https://control-tower.generarise.space,https://app.control-tower.generarise.space
# En desarrollo, dejar vacío permite localhost.
CORS_ORIGINS=

# ----- AI Providers -----
# Proveedor primario (groq | gemini | openai)
AI_PRIMARY_PROVIDER=groq
# Proveedor de fallback (groq | gemini | openai). Vacío desactiva fallback.
AI_FALLBACK_PROVIDER=gemini

# Modelo primario de chat
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_TEXT_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

GEMINI_MODEL=gemini-2.5-flash

OPENAI_WHISPER_MODEL=whisper-1

# API Keys (NO COMMITEAR VALORES REALES)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ----- WhatsApp / Evolution API -----
# Número del bot (en formato internacional, sólo dígitos)
BOT_PHONE=5491173719972
# Secreto opcional para validar webhooks entrantes (header x-webhook-secret)
WHATSAPP_WEBHOOK_SECRET=
# Anti-loop guard (ms) - previene respuestas duplicadas por chofer
LOOP_GUARD_MS=30000

# Evolution API
EVOLUTION_API_URL=https://trafic.generarise.space
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=control-tower

# ----- Media / Uploads -----
UPLOAD_DIR=
MEDIA_MAX_BYTES=52428800
MEDIA_DOWNLOAD_TIMEOUT_MS=15000

# ----- Onboarding / Demo -----
# Si está en "true", crea automáticamente la empresa demo y admin al iniciar
# (útil para primer arranque o demo comercial).
SEED_DEMO_DATA=true
# Si SEED_DEMO_DATA=true, define un password aleatorio impreso por consola al
# primer arranque. Si DEMO_ADMIN_PASSWORD está seteado, se usa ese (sólo dev).
DEMO_ADMIN_PASSWORD=
